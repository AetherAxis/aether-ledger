<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- 从 Aether monorepo 根 CPM 抄出的独立版本面（2026-10-19 抽取时点） -->
